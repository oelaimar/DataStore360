# ---------------------------------------------------------------
# DataStore360 — .gitignore
# ---------------------------------------------------------------

# --- Secrets et variables d'environnement ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Configuration Airflow (mots de passe) ---
# Les identifiants sont definis dans .env et generes au demarrage du
# conteneur (voir scripts/airflow-entrypoint.sh). On ignore par securite
# tout JSON genere dans le dossier config.
config/*.json
!config/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Environnements virtuels / uv ---
.venv/
venv/
env/
.python-version
# uv.lock DOIT etre versionne (reproductibilite) -> ne pas ignorer

# --- Tests, cache, linters ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Jupyter ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
.jupyter/
profile_default/
ipython_config.py

# --- Donnees ---
# Les datasets ne sont pas versionnes (volume + donnees personnelles en clair
# dans le fichier source). On conserve uniquement l'arborescence.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.xlsx
*.parquet
*.db
*.sqlite3
# Exception : petits echantillons de demo si besoin
!data/sample/*.csv

# --- Rapports ---
# rapport_profiling.html est un livrable attendu -> versionne
reports/*
!reports/.gitkeep
!reports/rapport_profiling.html
# Figures generees automatiquement
reports/figures/

# --- Airflow ---
logs/
airflow.db
airflow.cfg
airflow-webserver.pid
webserver_config.py
standalone_admin_password.txt
dags/__pycache__/
plugins/__pycache__/

# --- Docker ---
.docker/
docker-compose.override.yml
# Volumes montes localement (PostgreSQL, pgAdmin)
pgdata/
postgres-data/
pgadmin-data/

# --- IDE / editeurs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Systeme ---
.DS_Store
Thumbs.db
desktop.ini