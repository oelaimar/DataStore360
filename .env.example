# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# ---- Airflow ----
AIRFLOW_UID=50000

# Airflow Simple Auth Manager (login credentials)
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_ROLE=Admin

# Airflow PostgreSQL database
AIRFLOW_DB=airflow